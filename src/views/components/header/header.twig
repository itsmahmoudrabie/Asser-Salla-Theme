{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
{% set important_links = theme.settings.get('important_links') %}
<header data-testid="store-header" class="store-header relative z-30 font-primary">

  {# 1. Top Navbar (Bar for announcement, contacts, lang & dark mode) #}
  <div class="top-navbar bg-darker text-gray-200 border-b border-gray-800 transition-colors duration-300">
    <div class="container flex items-center justify-between gap-4 py-2 text-xs">
      
      {# Right side (RTL): Contacts & Links #}
      <div class="flex items-center gap-3">
        <salla-contacts data-testid="store-header-contacts" is-header class="text-xs text-gray-300 font-medium"></salla-contacts>
        {% if important_links %}
          <div class="hidden lg:flex items-center border-r border-gray-700/60 pr-3 rtl:border-r-0 rtl:border-l rtl:pr-0 rtl:pl-3">
            <salla-menu data-testid="store-header-topnav" source="footer" topnav></salla-menu>
          </div>
        {% endif %}
      </div>

      {# Center: Quick Search Bar Trigger #}
      {# <div class="header-search flex-1 max-w-md hidden md:block mx-4">
        <button type="button" 
                data-search-trigger
                class="w-full flex items-center justify-between px-4 py-2 text-xs text-gray-300 bg-gray-900/80 hover:bg-gray-900 border border-gray-700/80 hover:border-primary/60 rounded-full transition-all duration-300 shadow-inner group cursor-pointer"
                aria-label="{{ trans('blocks.header.search_placeholder')|default('ابحث عن منتج...') }}">
          <span class="flex items-center gap-2 text-gray-300 group-hover:text-white transition-colors">
            <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <span>{{ trans('blocks.header.search_placeholder')|default('ابحث عن منتج...') }}</span>
          </span>
          <span class="text-[10px] text-gray-400 bg-gray-800/90 px-2 py-0.5 rounded border border-gray-700 font-mono">Ctrl + K</span>
        </button>
      </div> #}

      {# Left side (RTL): Language, Currency, Dark Mode Toggle, Branch Scope #}
      <div class="flex items-center gap-2">
        {% if store.scope %}
            <button class="header-pill-btn flex items-center gap-1 text-xs"
                    onclick="salla.event.dispatch('scopes::open', {'mode': 'default'})">
                <i class="sicon-location text-primary"></i>
                <span class="truncate max-w-[100px]">{{ store.scope.name }}</span>
            </button>
        {% endif %}

        {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
            <div class="header-pill-wrapper flex items-center">
              <salla-localization-modal data-testid="store-header-localization" show-trigger></salla-localization-modal>
            </div>
        {% endif %}

        {% if theme.settings.get('enable_dark_mode_toggle', true) %}
            <button type="button" class="dark-mode-toggle header-pill-btn" data-dark-mode-toggle aria-label="{{ trans('common.titles.toggle_dark_mode') }}">
                <svg class="dark-mode-toggle__icon dark-mode-toggle__icon--moon w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                <svg class="dark-mode-toggle__icon dark-mode-toggle__icon--sun w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path></svg>
            </button>
        {% endif %}
      </div>

    </div>
  </div>

  {# Mobile Search Container for small screens #}
  {# <div class="md:hidden bg-darker/90 px-4 py-2 border-b border-gray-800">
    <button type="button" 
            data-search-trigger
            class="w-full flex items-center justify-between px-4 py-2 text-xs text-gray-300 bg-gray-900/90 border border-gray-700/80 rounded-full cursor-pointer active:scale-98 transition-transform"
            aria-label="{{ trans('blocks.header.search_placeholder')|default('ابحث عن منتج...') }}">
      <span class="flex items-center gap-2 text-gray-300">
        <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <span>{{ trans('blocks.header.search_placeholder')|default('ابحث عن منتج...') }}</span>
      </span>
      <span class="text-[10px] text-primary font-medium">بحث</span>
    </button>
  </div> #}

  {# 2. Main Navigation Bar (Logo, Main Menu, Actions) #}
  <div id="mainnav" class="main-nav-container bg-white/95 dark:bg-darker/95 backdrop-blur-xl border-b border-gray-100 dark:border-gray-800 shadow-sm transition-all duration-300">
      <div class="inner bg-transparent w-full">
          <div class="container">
              <div class="flex items-center justify-between py-3.5 relative">
                  
                  {# Right Side: Mobile Hamburger & Store Logo #}
                  <div class="flex items-center gap-4 lg:gap-8">
                      <a data-testid="store-header-mobile-toggle" class="lg:hidden p-2.5 rounded-xl bg-gray-100 dark:bg-gray-800 hover:bg-primary/10 transition-colors leading-none" href="#mobile-menu" aria-label="Open-menu">
                        <i class="sicon-menu text-primary text-xl"></i>
                      </a>

                      <a data-testid="store-header-logo" class="navbar-brand group flex items-center transition-all duration-300 hover:opacity-90" href="{{ store.url }}">
                          <img fetchpriority="high" class="max-h-12 lg:max-h-14 w-auto object-contain transition-all" src="{{ store.logo|cdn(175) }}" alt="{{ store.name }} logo">
                          {% if is_page('index') %}
                            <h1 class="sr-only">{{ store.name }}</h1>
                          {% else %}
                            <h2 class="sr-only">{{ store.name }}</h2>
                          {% endif %}
                      </a>
                  </div>

                  {# Center: Main Menu Links #}
                  <div class="hidden lg:flex items-center justify-center flex-1 mx-6">
                    <custom-main-menu></custom-main-menu>
                  </div>

                  {# Left Side: Search, Account & Cart Actions #}
                  <div class="flex items-center gap-2 sm:gap-3">
                      <button type="button" 
                              data-search-trigger
                              class="header-btn header-action-btn flex items-center justify-center cursor-pointer group"
                              aria-label="{{ trans('blocks.header.search_placeholder')|default('البحث') }}"
                              title="{{ trans('blocks.header.search_placeholder')|default('البحث') }}">
                        <span class="header-btn__icon flex items-center justify-center">
                          <svg class="w-5 h-5 text-gray-700 dark:text-gray-200 group-hover:text-primary transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                          </svg>
                        </span>
                      </button>

                      <div class="header-action-btn">
                        <salla-user-menu data-testid="store-header-user-menu" avatar-only show-header show-trigger></salla-user-menu>
                      </div>
                      
                      <div class="header-cart-wrapper">
                        <salla-cart-summary data-testid="store-header-cart">
                          <i slot="icon" class="header-btn__icon icon sicon-shopping-bag"></i>
                        </salla-cart-summary>
                      </div>
                  </div>

              </div>
          </div>
      </div>
  </div>
</header>

{# Search Slider Drawer (Off-Canvas Side Drawer like Cart) #}
<div id="search-slider-drawer" 
     class="search-slider-drawer fixed inset-0 z-[100] pointer-events-none opacity-0 invisible transition-all duration-300"
     role="dialog" 
     aria-modal="true" 
     aria-label="{{ trans('blocks.header.search_placeholder')|default('البحث عن منتجات') }}">
  
  {# Backdrop Overlay #}
  <div class="search-slider-overlay fixed inset-0 bg-black/60 backdrop-blur-md transition-opacity duration-300 opacity-0 cursor-pointer"
       data-close-search-slider></div>

  {# Slide-over Drawer Panel #}
  <div class="search-slider-panel fixed top-0 bottom-0 ltr:right-0 rtl:left-0 w-full sm:w-[460px] bg-white dark:bg-darker shadow-2xl flex flex-col transition-transform duration-300 ease-out transform ltr:translate-x-full rtl:-translate-x-full z-10 border-l border-r border-gray-100 dark:border-gray-800">
    
    {# Drawer Header #}
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 dark:border-gray-800 bg-gray-50/80 dark:bg-gray-900/80 backdrop-blur-sm">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <div>
          <h3 class="text-base font-bold text-gray-900 dark:text-white leading-tight">{{ trans('blocks.header.search_placeholder')|default('البحث في المتجر') }}</h3>
          <p class="text-[11px] text-gray-500 dark:text-gray-400">ابحث عن المنتجات والأقسام بسرعة</p>
        </div>
      </div>
      
      <button type="button" 
              class="p-2 rounded-full text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 hover:bg-gray-200/60 dark:hover:bg-gray-800 transition-colors cursor-pointer" 
              data-close-search-slider
              aria-label="إغلاق">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    {# Drawer Content Body #}
    <div class="search-slider-body flex-1 overflow-y-auto p-6 space-y-4">
      <salla-search data-testid="store-slider-search" inline oval height="46"></salla-search>
    </div>

    {# Drawer Footer #}
    <div class="p-4 border-t border-gray-100 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-900/50 text-center text-xs text-gray-400">
      <span>اضغط <kbd class="px-1.5 py-0.5 text-[10px] bg-gray-200 dark:bg-gray-800 rounded font-mono">ESC</kbd> للإغلاق</span>
    </div>

  </div>
</div>

